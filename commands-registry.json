    { "command": "/persona", "aliases": ["/role", "/роль", "/персона", "/character", "/характер"], "handler": "forward", "description": "Роль ассистента для профиля" },
    { "command": "/project", "aliases": ["/projects", "/проект", "/проекты"], "handler": "forward", "description": "Проекты профиля: список/смена/создание" },
